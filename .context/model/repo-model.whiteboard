t_port: int | None, claude_settings: Path)\n+ project_for(tool: str): Path | None\n+ tool_request(tool: str, host: McpHost): ToolRequest", "kind": "rect", "size": "small", "textAlign": "left", "x": 6264.0, "y": 11290.0, "w": 700, "h": 213}, "class.2db84bd393ae": {"type": "shape", "color": "#e6e6e6", "text": "`harness/mcp`\n**ProjectToolsets**\n---\n+ repo: Path | None\n+ project: Path | None\n+ started: bool\n+ tools: dict[str, AgentTool]\n+ prompts: dict[str, AgentTool]\n+ skipped: SkippedTools\n---\n+ ProjectToolsets(repo: str | Path | None, project: str | Path | None)\n+ enroll(tool: AgentTool): None\n+ start(toolsets: Iterable[ToolsetReference]): None\n+ for_project(project: Path): ProjectToolsets\n+ restarted(): ProjectToolsets\n+ resolve_call_name(name: str): str\n+ enrolled(name: str): AgentTool | None\n+ call_seconds(name: str): float\n+ invoke(mcp_name: str, arguments: dict[str, object] | None): object\n+ answer(mcp_name: str, call: ToolCall): object", "kind": "rect", "size": "small", "textAlign": "left", "x": 5424.0, "y": 11290.0, "w": 560, "h": 444}, "class.68b7bf81b54a": {"type": "shape", "color": "#e6e6e6", "text": "`harness/mcp`\n**McpInstallation**\n---\n+ destination: Mcp\n+ << association >> served: ServedCheckout\n+ daemon: McpDaemon\n+ claude_plugins: ClaudePlugins\n+ server: McpChannelServer\n+ << composition >> cdd_entry: CddEntry\n+ mcp_operations: list[AgentTool]\n+ toolsets: tuple[type, ...]\n+ published: list[str]\n---\n+ McpInstallation(target: InstallTarget, record: InstallRecord, served: ServedCheckout)\n+ create(target: InstallTarget, record: InstallRecord, repository: RepositoryToolsets | None): McpInstallation\n+ write(tool: AgentTool): None\n+ write_once_recorded(): None\n+ status(): list[str]", "kind": "rect", "size": "small", "textAlign": "left", "x": 6484.0, "y": 8565.0, "w": 680.0, "h": 633.0}, "class.997b07c5f6b7": {"type": "shape", "color": "#e6e6e6", "text": "`harness/mcp`\n**McpChannelServer**\n---\n+ << association >> served: ServedCheckout\n+ runs_this_process: bool\n---\n+ McpChannelServer(served: ServedCheckout, daemon: McpDaemon, claude_plugins: ClaudePlugins, layout: IdeLayout)\n+ stand_up(): StandUp\n+ ensure_running(): list[str]\n+ install_mods(): list[str]", "kind": "rect", "size": "small", "textAlign": "left", "x": 7144.0, "y": 10260.0, "w": 860, "h": 234}, "class.f898cd1da1f0": {"type": "shape", "color": "#e6e6e6", "text": "`harness/mcp`\n**CddHome**\n---\n+ folder: Path\n+ state_path: Path\n+ log_path: Path\n+ connect_script: Path\n+ runtime_record: Path\n+ pinned_checkout: Path\n+ is_installed: bool\n+ is_dev_lane: bool\n+ stable_lane: CddHome\n+ dev_lane: CddHome\n+ source: Path\n+ mode: str\n+ served_branch: str\n+ served_worktree: Path | None\n+ interpreter: PythonInterpreter\n+ server_environment: dict[str, str]\n+ marketplace: ClaudeMarketplace\n---\n+ CddHome(folder: Path | str | None)\n+ is_pinned_to(checkout: Path | str): bool\n+ install(checkout: Path | str, connect_script: Path | str): None\n+ pin(checkout: Path | str): str\n+ serve_current(checkout: Path | str): None\n+ serve_from(checkout: Path | str): None", "kind": "rect", "size": "small", "textAlign": "left", "x": 5664.0, "y": 7895.0, "w": 520.0, "h": 528.0}, "class.c611db1a4d1b": {"type": "shape", "color": "#e6e6e6", "text": "`harness/mcp`\n**ClaudeMarketplace**\n---\n+ folder: Path\n+ INSTALL_COMMAND: str\n+ cdd_plugin: PublishedPlugin\n+ mods: list[PublishedPlugin]\n+ install_command: list[str]\n---\n+ ClaudeMarketplace(folder: Path, home: CddHome)\n+ plugin(name: str): PublishedPlugin\n+ mod_folder(plugin: PublishedPlugin): Path\n+ publish_cdd_plugin(server: dict[str, object]): list[Path]\n+ publish_mods(code: Path): None\n+ publish_mods_for_chats(is_dev_lane_running: bool): None", "kind": "rect", "size": "small", "textAlign": "left", "x": 7244.0, "y": 11290.0, "w": 480, "h": 339}, "class.7f08c935c0ea": {"type": "shape", "color": "#e6e6e6", "text": "`harness/mcp`\n**PublishedPlugin**\n---\n+ marketplace: C