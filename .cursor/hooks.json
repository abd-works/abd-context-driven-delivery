{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "python hooks/manifest_gate.py post",
        "timeout": 35,
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "command": "python hooks/manifest_gate.py pre",
        "timeout": 35,
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "python hooks/manifest_gate.py post",
        "timeout": 35,
        "failClosed": false
      }
    ],
    "beforeReadFile": [
      {
        "command": "python hooks/manifest_gate.py read",
        "timeout": 35,
        "failClosed": false
      }
    ],
    "PostToolUse": [
      {
        "command": "python hooks/manifest_gate.py post",
        "matcher": "Read",
        "timeout": 35,
        "failClosed": false
      }
    ],
    "PreToolUse": [
      {
        "command": "python hooks/manifest_gate.py pre",
        "matcher": "Write|StrReplace|EditNotebook",
        "timeout": 35,
        "failClosed": false
      }
    ]
  }
}