# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Manifest gate local state
primitives/tools/hooks/.manifest_gate_clearance.json
primitives/tools/hooks/manifest_gate.log

# Sandbox Node toolchain
sandbox/node_modules/

# Generated deploy state (local; the deployed .cursor artifacts are tracked)
.kilo/
utilities/agent_skills/.deploy-state.json
primitives/harness/.deploy-state.json

# SessionLog append-only audit trails (runtime; not sprint artifacts)
**/logs/events.log

# Hook runtime logs under active session folders (archived to .sessions/closed/ on close)
.context/sessions/*/logs/
.context/prompt-log.txt
.context/hooks/turn/auto_turn.last_run.json
primitives/hooks/dispatch.debug
primitives/hooks/skill_inject.debug
primitives/hooks/prompt_echo.debug
primitives/hooks/prompt_echo/prompt_echo.debug

# Ephemeral tool run requests (python -m tools run _req.yaml)
/_req.yaml
/_req*.yaml

# Virtualenv & Secrets
.venv/
conf/
*.secrets.txt

# Temporary scratch files and scripts
_*
call_miro.py
count_all.py
extract_ids.py
find_ids.py
gen_full*.py
parse_board*.py
story_map_ids.txt
