  "class.3b1048740c51": {
   "type": "shape",
   "color": "#d6e4f5",
   "text": "`Customer`\n*«Aggregate Root» «Entity»*\n**Customer**\n---\n+ id: string\n+ verified: boolean\n+ identity: Identity\n+ address: Address\n+ accountCredentials: AccountCredentials\n+ cart: Cart | null\n+ billing: Billing | null\n+ subscriptions: Subscription[]\n+ personaInquiry: PersonaInquiry | null\n---\n+ Customer(accountCredentials: AccountCredentials)\n+ confirmIdentity(): Customer",
   "kind": "rect",
   "size": "small",
   "textAlign": "left",
   "x": 928.0,
   "y": 638.0,
   "w": 400.0,
   "h": 360.0
  },
  "class.0acf18f28963": {
   "type": "shape",
   "color": "#d6e4f5",
   "text": "`Customer`\n*«Repository»*\n**CustomerRepository**\n---\n+ customers: Collection<Customer>\n+ midtierCustomerService: MidtierCustomerService\n---\n+ CustomerRepository(...)\n+ create(accountCredentials: AccountCredentials): Customer | null\n+ load(accountCredentials: AccountCredentials): Customer",
   "kind": "rect",
   "size": "small",
   "textAlign": "left",
   "x": 48.0,
   "y": 108.0,
   "w": 520.0,
   "h": 234.0
  },
  "class.7430ccf06e86": {
   "type": "shape",
   "color": "#d6e4f5",
   "text": "`Customer`\n*«Service»*\n**MidtierCustomerService**\n---\n---\n+ MidtierCustomerService(...)\n+ validate(accountToken: AccountToken): string | Error\n+ create(accountToken: AccountToken): string | Error\n+ read(accountToken: AccountToken): MavenirCustomer | Error",
   "kind": "rect",
   "size": "small",
   "textAlign": "left",
   "x": 208.0,
   "y": 638.0,
   "w": 480.0,
   "h": 213.0
  },
  "class.97a3105280f1": {
   "type": "shape",
   "color": "#d6e4f5",
   "text": "`Customer`\n*«Exception»*\n**CustomerException**\n---\n+ operation: CustomerOperation\n+ accountCredentials: AccountCredentials\n+ message: string\n+ cause: Error\n---\n+ CustomerException(...)",
   "kind": "rect",
   "size": "small",
   "textAlign": "left",
   "x": 1768.0,
   "y": 108.0,
   "w": 340.0,
   "h": 234.0
  },
  "class.d75a2bfac507": {
   "type": "shape",
   "color": "#d6e4f5",
   "text": "`Customer`\n*«Entity»*\n**Identity**\n---\n+ email: string\n+ name: string\n+ lastName: string\n+ fullName: string\n+ preferredName: string\n+ expiryDate: string\n+ dateOfBirth: string\n+ idNationality: string\n+ idNumber: string\n+ idType: string\n+ otherPhoneNumber: string\n---\n+ Identity(...)",
   "kind": "rect",
   "size": "small",
   "textAlign": "left",
   "x": 1578.0,
   "y": 1138.0,
   "w": 220.0,
   "h": 381.0
  },
  "class.c0e433fef93a": {
   "type": "shape",
   "color": "#d6e4f5",
   "text": "`Customer`\n*«Entity»*\n**Address**\n---\n+ street: string\n+ complement: string\n+ city: string\n+ parish: string\n+ postalCode: string\n+ country: string\n---\n+ Address(...)",
   "kind": "rect",
   "size": "small",
   "textAlign": "left",
   "x": 1898.0,
   "y": 1138.0,
   "w": 200.0,
   "h": 276.0
  },
  "class.b0df9b5197a5": {
   "type": "shape",
   "color": "#d6e4f5",
   "text": "`Customer`\n*«Aggregate Root» «Entity»*\n**AccountCredentials**\n---\n+ email: string\n+ password: string\n+ confirmPassword: string\n+ validationCode: string\n+ verified: boolean\n+ token: AccountToken | null\n+ customerId: string | null\n+ validationCodeWasSent: boolean\n+ canActivate: boolean\n+ isUpdatable: boolean\n+ isPersistable: boolean\n+ resendMessage: string | null\n+ errors: AccountCredentialsErrors\n+ requirements: AccountCredentialRequirements\n---\n+ AccountCredentials(emailOrCognitoUser: string | CognitoUser)\n+ missingRequirements(): AccountCredentialRequirement[]\n+ register(): void\n+ activate(validationCode: ValidationCode): void\n+ authenticateAccount(): void\n+ resendValidationCode(): void\n+ signOut(): void\n+ storeCustomerId(customerId: string): CognitoUser",
   "kind": "rect",
   "size": "small",
   "textAlign": "left",
   "x": 2618.0,
   "y": 1138.0,
   "w": 500.0,
   "h": 591.0
  },
  "class.81d02e3acf04": {
   "type": "shape",
   "color": "#d6e4f5",
   "text": "`Customer`\n*«Repository»*\n**AccountRepository**\n---\n+ accountCredentials: Collection<AccountCredentials>\n+ amplifyService: AmplifyService\n---\n+ AccountRepository(...)\n+ newAccount(credentials?: AccountCredentials): AccountCredentials\n+ persistNewAccount(accountCredentials: AccountCredentials): CognitoUser | AccountCredentialsErrors\n+ confirmAccount(accountCredentials: AccountCredentials): CognitoUser | AccountCredentialsErrors\n+ authenticateAccount(accountCredentials: AccountCredentials): CognitoUser | AccountCredentialsErrors\n+ resendAccountCode(accountCredentials: AccountCredentials): CognitoUser | null",
   "kind": "rect",
   "size": "small",
