   "color": "#d6e4f5",
   "text": "`credentials`\n*«Value Object»*\n**TemporaryPassword**\n+ email: string\n+ password: string\n+ sentAt: Date\n– – –\n+ TemporaryPassword(email: string, password: string, sentAt: Date)",
   "kind": "rect",
   "size": "small",
