  "imported.4bf478a0083b": {
   "type": "shape",
   "color": "white",
   "text": "*«from: numbers»*\n**NumberInventory**\n+ msisdn: string\n+ imsi: string\n+ status: available | held | reserved\n+ interimPort: boolean",
   "kind": "rect",
