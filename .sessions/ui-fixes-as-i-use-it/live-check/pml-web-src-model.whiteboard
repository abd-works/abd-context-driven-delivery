  "imported.d4b5d6657918": {
   "type": "shape",
   "color": "white",
   "text": "*«from: credentials»*\n**Credentials**\n+ email: string\n+ password: string\n+ confirmPassword: string\n+ requirements: CredentialRequirements",
   "kind": "rect",
   "stroke": "#666666",
   "size": "small",
