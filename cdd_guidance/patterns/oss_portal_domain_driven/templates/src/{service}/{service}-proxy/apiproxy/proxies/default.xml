<ProxyEndpoint name="default">
  <!-- The standard policy chain, in the pack's order (§3.3). A change here is security-affecting (APP-05). -->
  <PreFlow>
    <Request>
      <Step><Name>verify-jwt</Name></Step>
      <Step><Name>assert-scope</Name></Step>
      <Step><Name>spike-arrest</Name></Step>
      <Step><Name>json-threat-protection</Name></Step>
    </Request>
    <Response>
      <Step><Name>audit-log</Name></Step>
    </Response>
  </PreFlow>
  <DefaultFaultRule name="sanitise"><Step><Name>sanitise-error</Name></Step></DefaultFaultRule>
  <HTTPProxyConnection><BasePath>/v1/{{serviceBasePath}}</BasePath></HTTPProxyConnection>
  <RouteRule name="default"><TargetEndpoint>default</TargetEndpoint></RouteRule>
</ProxyEndpoint>
