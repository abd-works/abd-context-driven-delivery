# Copy to conf/.secrets (gitignored). KEY=value — no spaces around =.
# Existing process environment wins. Utilities load this file, then imported files.

# Point at abd-answers so OpenAI + Pinecone keys stay in one place:
# SECRETS_IMPORT=C:\dev\abd-works-repo\abd-answers\conf\.secrets

# Optional local overrides / extras:
# OPENAI_API_KEY=
# PINECONE_API_KEY=
# PINECONE_INDEX=abd-answers
# PINECONE_NAMESPACE=abd-answers
# CONTENT_MEMORY_ROOT=C:\Users\jeffa\OneDrive - abd.works\Shared Documents\Assets\abd-answers-memory-pipeline
