{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@cdd/*": [
        "../../../.claude/language-adapters/typescript/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "@monaco-editor/react": [
        "./node_modules/@monaco-editor/react"
      ]
    }
  },
  "include": [
    "*.ts",
    "*.tsx",
    "data-management",
    "filter",
    "graph",
    "labels",
    "source"
  ]
}
