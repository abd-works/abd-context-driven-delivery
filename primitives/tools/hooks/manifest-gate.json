{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "python primitives/tools/hooks/manifest_gate.py post",
        "timeout": 60,
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "command": "python primitives/tools/hooks/manifest_gate.py pre",
        "timeout": 60,
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "python primitives/tools/hooks/manifest_gate.py post",
        "timeout": 60,
        "failClosed": false
      }
    ],
    "beforeReadFile": [
      {
        "command": "python primitives/tools/hooks/manifest_gate.py read",
        "timeout": 60,
        "failClosed": false
      }
    ],
    "afterShellExecution": [
      {
        "command": "python primitives/tools/hooks/manifest_gate.py shell",
        "timeout": 15,
        "failClosed": false
      }
    ]
  }
}
