{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@src/*": [
        "./src/*"
      ],
      "@cdd/*": [
        "../../../.claude/language-adapters/typescript/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "test-utils/*": [
        "./test-utils/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src",
    "packages",
    "tests",
    "test-utils",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
