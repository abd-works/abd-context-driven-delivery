        <mxCell id="space-repo--commit" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Commit&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ sha: str&lt;br/&gt;+ subject: str&lt;br/&gt;+ message: str&lt;br/&gt;+ trailers: dict[str, str]&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ Commit(sha: str, message: str)&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;module=space/repo;" vertex="1" parent="1">
          <mxGeometry x="3800" y="1110" width="200" height="126" as="geometry" />
        </mxCell>
        <mxCell id="space-repo--branch" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Branch&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ repo: Repo&lt;br/&gt;+ name: str&lt;br/&gt;+ exists: bool&lt;br/&gt;+ is_checked_out: bool&lt;br/&gt;+ is_checked_out_here: bool&lt;br/&gt;+ is_default: bool&lt;br/&gt;+ checkout: Repo | None&lt;br/&gt;+ linked_worktree: Repo | None&lt;br/&gt;+ start_point: str&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ Branch(repo: Repo, name: str)&lt;br/&gt;+ changed_files(): list[str]&lt;br/&gt;+ check_out(): Branch&lt;br/&gt;+ open_in_worktree(): Repo&lt;br/&gt;+ save(commit_message: str, push: bool): None&lt;br/&gt;+ push(): None&lt;br/&gt;+ land_on_default(): None&lt;br/&gt;+ merge_into_default(): Repo&lt;br/&gt;+ delete(unmerged: bool): None&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;module=space/repo;" vertex="1" parent="1">
          <mxGeometry x="2220" y="1400" width="280" height="334" as="geometry" />
        </mxCell>
        <mxCell id="space-repo--worktrees" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Worktrees&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ by_branch: dict[Branch, Repo]&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ Worktrees(repo: Repo, checkouts: ServedCheckouts)&lt;br/&gt;+ repository_at(folder: Path | str): Repo&lt;br/&gt;+ at(folder: Path | str): Repo | None&lt;br/&gt;+ of(branch: Branch): Repo | None&lt;br/&gt;+ open(branch: Branch): Repo&lt;br/&gt;+ primary_root(): Path&lt;br/&gt;+ sibling_folder(branch: Branch): Path&lt;br/&gt;+ add(path: str | Path, branch: Branch): Repo&lt;br/&gt;+ remove(worktree: Repo): None&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;module=space/repo;" vertex="1" parent="1">
          <mxGeometry x="1880" y="1860" width="300" height="206" as="geometry" />
        </mxCell>
        <mxCell id="space-repo--worktreeclearing" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;WorktreeClearing&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ WorktreeClearing(worktrees: Worktrees, main_clone: Repo, keeping: Repo)&lt;br/&gt;+ clear(): ClearedWorktrees&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;module=space/repo;" vertex="1" parent="1">
          <mxGeometry x="140" y="3044" width="420" height="80" as="geometry" />
        </mxCell>
        <mxCell id="space-repo--clearedworktrees" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ClearedWorktrees&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ removed: list[ClearedFolder]&lt;br/&gt;+ kept: list[ClearedFolder]&lt;br/&gt;+ report: str&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ ClearedWorktrees()&lt;br/&gt;+ remove(folder: Path, reason: str): None&lt;br/&gt;+ keep(folder: Path, reason: str): None&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;module=space/repo;" vertex="1" parent="1">
          <mxGeometry x="60" y="3264" width="260" height="142" as="geometry" />
        </mxCell>
        <mxCell id="space-repo--clearedfolder" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ClearedFolder&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ folder: str&lt;br/&gt;+ reason: str&lt;br/&gt;+ line: str&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;module=space/repo;" vertex="1" parent="1">
