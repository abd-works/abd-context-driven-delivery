        <mxCell id="space-repo--newrepository" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;NewRepository&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ root: Path&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ NewRepository(repo: Repo)&lt;br/&gt;+ create(): MadeRepository&lt;br/&gt;+ make_from_folder(): MadeRepository&lt;br/&gt;+ ignore_as_cdd_does(): int&lt;br/&gt;+ write_ignores(): int&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;module=space/repo;" vertex="1" parent="1">
          <mxGeometry x="380" y="2568" width="220" height="142" as="geometry" />
